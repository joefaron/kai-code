<mxfile host="the boat site"><diagram id="where-it-goes" name="Where it goes"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style=&quot;font-size:22px&quot;&gt;S.S. Jack-o'-Lantern: where every part goes&lt;/b&gt;&lt;br&gt;Two batteries, two jobs: the power bank runs the BRAIN, the AA pack runs the MOTORS." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="60" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;LEFT motor&lt;/b&gt;&lt;br&gt;port side" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff7ed;strokeColor=#c2410c;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="150" height="60" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;RIGHT motor&lt;/b&gt;&lt;br&gt;starboard side" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff7ed;strokeColor=#c2410c;" vertex="1" parent="1"><mxGeometry x="20" y="430" width="150" height="60" as="geometry"/></mxCell><mxCell id="c5" value="&lt;i&gt;Breadboard (exact holes: see the breadboard view on the Wiring page)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f1f5f9;strokeColor=#94a3b8;align=left;verticalAlign=bottom;spacingLeft=8;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="240" y="170" width="760" height="330" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;+ rail&lt;/b&gt; (motor battery +)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#991b1b;" vertex="1" parent="1"><mxGeometry x="240" y="510" width="760" height="24" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;− rail&lt;/b&gt; = GND. Every ground joins here" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;" vertex="1" parent="1"><mxGeometry x="240" y="540" width="760" height="24" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;DRV8833 motor driver&lt;/b&gt;&lt;br&gt;= the MUSCLES&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;ESP32 whispers 3.3 V; this switches&lt;br&gt;the battery into the motors.&lt;br&gt;&lt;b&gt;Solder its 12 pins first.&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ede9fe;strokeColor=#6d28d9;" vertex="1" parent="1"><mxGeometry x="260" y="330" width="200" height="130" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;ESP32&lt;/b&gt; = the BRAIN + Wi-Fi radio&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;runs the code, makes the boat's own hotspot.&lt;br&gt;Every wire uses its D32…GND side (row a is free there).&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dcfce7;strokeColor=#15803d;" vertex="1" parent="1"><mxGeometry x="620" y="205" width="320" height="160" as="geometry"/></mxCell><mxCell id="c10" value="micro&lt;br&gt;USB" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#9ca3af;strokeColor=#374151;fontSize=10;" vertex="1" parent="1"><mxGeometry x="940" y="260" width="44" height="44" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;3 LEDs&lt;/b&gt; + 220 Ω each&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;D14 red = port · D12 green = starboard&lt;br&gt;D13 yellow = stern (blinks = no tablet)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fef9c3;strokeColor=#a16207;" vertex="1" parent="1"><mxGeometry x="720" y="385" width="250" height="70" as="geometry"/></mxCell><mxCell id="c12" value="&lt;span style=&quot;color:#2563eb&quot;&gt;&lt;b&gt;4 signal wires&lt;/b&gt;&lt;br&gt;D32→IN1&lt;br&gt;D33→IN2&lt;br&gt;D25→IN3&lt;br&gt;D26→IN4&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="250" width="110" height="100" as="geometry"/></mxCell><mxCell id="c13" value="&lt;span style=&quot;color:#8b5cf6&quot;&gt;&lt;b&gt;D27 → EEP&lt;/b&gt;&lt;br&gt;(driver ON)&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="440" width="110" height="40" as="geometry"/></mxCell><mxCell id="c14" value="&lt;span style=&quot;color:#6b7280&quot;&gt;&lt;b&gt;C → micro&lt;br&gt;cable&lt;/b&gt;&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="985" y="245" width="90" height="40" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;USB-C power bank&lt;/b&gt;&lt;br&gt;(Mark Rober pack)&lt;br&gt;powers ONLY the ESP32" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fef3c7;strokeColor=#b45309;" vertex="1" parent="1"><mxGeometry x="1070" y="240" width="180" height="84" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;8×AA holder + switch&lt;/b&gt;&lt;br&gt;6 AA + 2 dummies = 9 V&lt;br&gt;switch = motor kill switch" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fef3c7;strokeColor=#b45309;" vertex="1" parent="1"><mxGeometry x="1070" y="470" width="180" height="84" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;strokeWidth=8;strokeColor=#6b7280;fontStyle=1;fontSize=12;fontColor=#6b7280;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="red" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;strokeWidth=3;strokeColor=#dc2626;fontStyle=1;fontSize=12;fontColor=#dc2626;labelBackgroundColor=#ffffff;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="black" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;strokeWidth=3;strokeColor=#111111;fontStyle=1;fontSize=12;fontColor=#111111;labelBackgroundColor=#ffffff;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="VCC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;strokeWidth=3;strokeColor=#dc2626;fontStyle=1;fontSize=12;fontColor=#dc2626;labelBackgroundColor=#ffffff;exitX=0.1;exitY=0;exitDx=0;exitDy=0;entryX=0.2;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="GND" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;strokeWidth=3;strokeColor=#111111;fontStyle=1;fontSize=12;fontColor=#111111;labelBackgroundColor=#ffffff;exitX=0.2;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="GND" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;strokeWidth=3;strokeColor=#111111;fontStyle=1;fontSize=12;fontColor=#111111;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.1;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="GND" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;strokeWidth=3;strokeColor=#111111;fontStyle=1;fontSize=12;fontColor=#111111;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.79;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;strokeWidth=5;strokeColor=#2563eb;fontStyle=1;fontSize=12;fontColor=#2563eb;labelBackgroundColor=#ffffff;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;strokeWidth=3;strokeColor=#8b5cf6;fontStyle=1;fontSize=12;fontColor=#8b5cf6;labelBackgroundColor=#ffffff;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="c9" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="OUT1 + OUT2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;strokeWidth=3;strokeColor=#444444;fontStyle=1;fontSize=12;fontColor=#444444;labelBackgroundColor=#ffffff;exitX=0;exitY=0.35;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="OUT3 + OUT4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;strokeWidth=3;strokeColor=#444444;fontStyle=1;fontSize=12;fontColor=#444444;labelBackgroundColor=#ffffff;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Why two batteries?&lt;/b&gt; A motor starting up gulps power. On its own battery it can't starve the ESP32 and make it reboot mid-race.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why do all the grounds join?&lt;/b&gt; A signal is a voltage &lt;i&gt;compared to ground&lt;/i&gt;. Without a shared ground, the driver can't &quot;hear&quot; the ESP32.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why is every wire on one side of the ESP32?&lt;/b&gt; It is so wide that only one side has a free hole next to its pins." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="590" width="330" height="220" as="geometry"/></mxCell><mxCell id="c29" value="Colour key: &lt;span style=&quot;color:#dc2626&quot;&gt;&lt;b&gt;red&lt;/b&gt;&lt;/span&gt; = + power · &lt;b&gt;black&lt;/b&gt; = GND · &lt;span style=&quot;color:#2563eb&quot;&gt;&lt;b&gt;blue&lt;/b&gt;&lt;/span&gt; = signals · &lt;span style=&quot;color:#8b5cf6&quot;&gt;&lt;b&gt;purple dashed&lt;/b&gt;&lt;/span&gt; = enable · &lt;span style=&quot;color:#6b7280&quot;&gt;&lt;b&gt;grey&lt;/b&gt;&lt;/span&gt; = USB cable" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="580" width="760" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="every-wire" name="Every wire"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style=&quot;font-size:20px&quot;&gt;Every wire, one at a time&lt;/b&gt;&lt;br&gt;Tick each one off. LED long leg goes toward the resistor/pin, short leg to the − rail." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="800" height="50" as="geometry"/></mxCell><mxCell id="c3" value="&lt;table style=&quot;border-collapse:collapse;font-size:13px&quot;&gt;&lt;tr style=&quot;background:#f1f5f9&quot;&gt;&lt;th style=&quot;border:1px solid #cbd5e1;padding:4px 10px&quot;&gt;#&lt;/th&gt;&lt;th style=&quot;border:1px solid #cbd5e1;padding:4px 10px&quot;&gt;From&lt;/th&gt;&lt;th style=&quot;border:1px solid #cbd5e1;padding:4px 10px&quot;&gt;To&lt;/th&gt;&lt;th style=&quot;border:1px solid #cbd5e1;padding:4px 10px&quot;&gt;Wire&lt;/th&gt;&lt;th style=&quot;border:1px solid #cbd5e1;padding:4px 10px&quot;&gt;Why&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:4px 10px&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:4px 10px&quot;&gt;&lt;b&gt;ESP32 D32&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:4px 10px&quot;&gt;&lt;b&gt;Driver IN1&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:4px 10px&quot;&gt;green&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:4px 10px&quot;&gt;left motor, direction 1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:4px 10px&quot;&gt;2&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:4px 10px&quot;&gt;&lt;b&gt;ESP32 D33&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:4px 10px&quot;&gt;&lt;b&gt;Driver IN2&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:4px 10px&quot;&gt;blue&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:4px 10px&quot;&gt;left motor, direction 2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:4px 10px&quot;&gt;3&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:4px 10px&quot;&gt;&lt;b&gt;ESP32 D25&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:4px 10px&quot;&gt;&lt;b&gt;Driver IN3&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:4px 10px&quot;&gt;yellow&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:4px 10px&quot;&gt;right motor, direction 1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:4px 10px&quot;&gt;4&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:4px 10px&quot;&gt;&lt;b&gt;ESP32 D26&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:4px 10px&quot;&gt;&lt;b&gt;Driver IN4&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:4px 10px&quot;&gt;orange&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:4px 10px&quot;